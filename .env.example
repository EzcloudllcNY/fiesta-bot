# Slack credentials. Both come from https://api.slack.com/apps → your app.
#   SLACK_BOT_TOKEN  OAuth & Permissions → Bot User OAuth Token
#   SLACK_APP_TOKEN  Basic Information → App-Level Tokens, scope connections:write
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Where the SQLite file lives. The Docker image overrides this to /app/data/fiesta.db.
FIESTA_DB_PATH=./data/fiesta.db

FIESTA_LOG_LEVEL=INFO

# Error reporting. Leave SENTRY_DSN empty to switch Sentry off, as in development.
#   SENTRY_DSN  Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Release name. Leave it commented out: the image build and local git fill in the
# commit sha. Even an empty value here would override the one baked into the image.
# SENTRY_RELEASE=
